---

<section class="bg-white py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
        Works With Your Entire Stack
      </h2>
      <p class="mt-4 text-lg text-neutral-500">
        Fluent in every major framework, language, and tool. No plugins. No configuration.
      </p>
    </div>

    <!-- Frameworks marquee -->
    <div class="reveal mt-14">
      <p class="mb-6 text-center text-xs font-semibold uppercase tracking-widest text-neutral-400">Frameworks &amp; Languages</p>
      <div class="relative overflow-hidden">
        <div class="absolute inset-y-0 left-0 z-10 w-16 bg-gradient-to-r from-white to-transparent"></div>
        <div class="absolute inset-y-0 right-0 z-10 w-16 bg-gradient-to-l from-white to-transparent"></div>
        <div class="animate-marquee flex w-max items-center gap-12">
          {[...frameworks, ...frameworks].map((fw) => (
            <div class="group flex flex-col items-center gap-2">
              <div class="flex h-12 w-12 items-center justify-center rounded-lg border border-neutral-100 bg-neutral-50 transition-all group-hover:border-neutral-200 group-hover:shadow-md">
                <svg class="h-6 w-6 text-neutral-400 transition-colors" style={`--brand-color: ${fw.color}`} viewBox="0 0 24 24" fill="currentColor">
                  <path d={fw.path} />
                </svg>
              </div>
              <span class="whitespace-nowrap text-xs text-neutral-400 transition-colors group-hover:text-neutral-700">{fw.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Tools marquee -->
    <div class="reveal mt-12">
      <p class="mb-6 text-center text-xs font-semibold uppercase tracking-widest text-neutral-400">Tools &amp; Platforms</p>
      <div class="relative overflow-hidden">
        <div class="absolute inset-y-0 left-0 z-10 w-16 bg-gradient-to-r from-white to-transparent"></div>
        <div class="absolute inset-y-0 right-0 z-10 w-16 bg-gradient-to-l from-white to-transparent"></div>
        <div class="animate-marquee-slow flex w-max items-center gap-12" style="animation-direction: reverse;">
          {[...tools, ...tools].map((tool) => (
            <div class="group flex flex-col items-center gap-2">
              <div class="flex h-12 w-12 items-center justify-center rounded-lg border border-neutral-100 bg-neutral-50 transition-all group-hover:border-neutral-200 group-hover:shadow-md">
                <svg class="h-6 w-6 text-neutral-400 transition-colors" style={`--brand-color: ${tool.color}`} viewBox="0 0 24 24" fill="currentColor">
                  <path d={tool.path} />
                </svg>
              </div>
              <span class="whitespace-nowrap text-xs text-neutral-400 transition-colors group-hover:text-neutral-700">{tool.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <p class="reveal mt-12 text-center text-neutral-500">
      <span class="font-medium text-neutral-700">Multi-language fluency.</span> Ageneer doesn&apos;t just know one framework &mdash; it understands your entire polyglot codebase and follows your team&apos;s conventions across every project.
    </p>
  </div>
</section>
