---
const steps = [
  {
    num: '01',
    title: 'Deploy',
    description: 'Self-host Ageneer on your own infrastructure. Your code never leaves your network.',
    icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 12h14M12 5l7 7-7 7"/></svg>`,
  },
  {
    num: '02',
    title: 'Connect',
    description: 'Point Ageneer at your repos, project management tools, and communication channels.',
    icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>`,
  },
  {
    num: '03',
    title: 'Assign',
    description: 'Give tasks via Slack, Teams, Discord, or even invite Ageneer to your video calls.',
    icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>`,
  },
  {
    num: '04',
    title: 'Ship',
    description: 'Ageneer analyzes, codes, tests, creates PRs, and communicates progress. Autonomously.',
    icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>`,
  },
];
---

<section id="how-it-works" class="bg-neutral-50 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
        Up and Running in Minutes
      </h2>
      <p class="mt-4 text-lg text-neutral-500">
        Deploy, connect, and start shipping. No complex setup required.
      </p>
    </div>

    <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, i) => (
        <div class={`reveal ${i > 0 ? `reveal-delay-${Math.min(i, 3)}` : ''} relative`}>
          {/* Connector line (desktop only) */}
          {i < steps.length - 1 && (
            <div class="absolute right-0 top-10 hidden h-px w-8 translate-x-full bg-gradient-to-r from-brand-300 to-brand-100 lg:block" />
          )}
          <div class="rounded-xl border border-neutral-200 bg-white p-6 transition-all hover:border-brand-200 hover:shadow-lg">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
              <Fragment set:html={step.icon} />
            </div>
            <div class="mb-1 text-xs font-bold uppercase tracking-widest text-brand-500">
              Step {step.num}
            </div>
            <h3 class="text-lg font-bold text-neutral-900">{step.title}</h3>
            <p class="mt-2 text-sm text-neutral-500 leading-relaxed">{step.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
