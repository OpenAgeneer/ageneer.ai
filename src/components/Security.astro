---
---

<section id="security" class="relative overflow-hidden bg-neutral-900 py-24 sm:py-32">
  <!-- Background grid -->
  <div class="bg-grid-pattern absolute inset-0 opacity-50"></div>

  <div class="relative mx-auto max-w-6xl px-6">
    <!-- Section header -->
    <div class="mx-auto max-w-2xl text-center reveal">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-green-500/30 bg-green-500/10 px-4 py-1.5">
        <svg class="h-4 w-4 text-green-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
        </svg>
        <span class="text-sm font-medium text-green-300">Enterprise-Grade Security</span>
      </div>

      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl">
        Security-First.<br />
        <span class="text-gradient">Your Code Stays Yours.</span>
      </h2>
      <p class="mt-4 text-lg text-neutral-400">
        Ageneer is designed for teams that take security seriously. No black boxes, no data lock-in, no vendor risk.
      </p>
    </div>

    <!-- Three pillars -->
    <div class="mt-16 grid gap-8 md:grid-cols-3">
      <!-- Self-Hosted -->
      <div class="reveal reveal-delay-1 rounded-2xl border border-white/10 bg-white/5 p-8 backdrop-blur-sm transition-all hover:border-white/20 hover:bg-white/[0.07]">
        <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-600/20 text-brand-400">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 0 1-3-3m3 3a3 3 0 1 0 0 6h13.5a3 3 0 1 0 0-6m-16.5-3a3 3 0 0 1 3-3h13.5a3 3 0 0 1 3 3m-19.5 0a4.5 4.5 0 0 1 .9-2.7L5.737 5.1a3.375 3.375 0 0 1 2.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 0 1 .9 2.7m0 0a3 3 0 0 1-3 3m0 3h.008v.008h-.008v-.008Zm0-6h.008v.008h-.008v-.008Zm-3 6h.008v.008h-.008v-.008Zm0-6h.008v.008h-.008v-.008Z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-white">Self-Hosted</h3>
        <p class="mt-3 text-neutral-400">
          Deploy Ageneer on your own infrastructure. Your code never leaves your environment. Works with AWS, GCP, Azure, or on-premise.
        </p>
        <ul class="mt-6 space-y-3">
          <li class="flex items-start gap-2 text-sm text-neutral-300">
            <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-green-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
            Your infrastructure, your rules
          </li>
          <li class="flex items-start gap-2 text-sm text-neutral-300">
            <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-green-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
            No data leaves your network
          </li>
          <li class="flex items-start gap-2 text-sm text-neutral-300">
            <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-green-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
            Full network isolation support
          </li>
        </ul>
      </div>

      <!-- Open Source -->
      <div class="reveal reveal-delay-2 rounded-2xl border border-white/10 bg-white/5 p-8 backdrop-blur-sm transition-all hover:border-white/20 hover:bg-white/[0.07]">
        <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-600/20 text-brand-400">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-white">Open Source</h3>
        <p class="mt-3 text-neutral-400">
          Fully open source from May 1, 2026. Audit every line of code, customize to your needs, and contribute back to the community.
        </p>
        <ul class="mt-6 space-y-3">
          <li class="flex items-start gap-2 text-sm text-neutral-300">
            <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-green-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
            Full source code transparency
          </li>
          <li class="flex items-start gap-2 text-sm text-neutral-300">
            <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-green-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
            Community-driven security audits
          </li>
          <li class="flex items-start gap-2 text-sm text-neutral-300">
            <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-green-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
            No vendor lock-in, ever
          </li>
        </ul>
      </div>

      <!-- Enterprise Ready -->
      <div class="reveal reveal-delay-3 rounded-2xl border border-white/10 bg-white/5 p-8 backdrop-blur-sm transition-all hover:border-white/20 hover:bg-white/[0.07]">
        <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-600/20 text-brand-400">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 0h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-white">Enterprise Ready</h3>
        <p class="mt-3 text-neutral-400">
          Built for teams that need compliance, access controls, and audit trails. SOC 2 and ISO 27001 compatible architecture.
        </p>
        <ul class="mt-6 space-y-3">
          <li class="flex items-start gap-2 text-sm text-neutral-300">
            <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-green-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
            Role-based access controls
          </li>
          <li class="flex items-start gap-2 text-sm text-neutral-300">
            <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-green-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
            Complete audit logging
          </li>
          <li class="flex items-start gap-2 text-sm text-neutral-300">
            <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-green-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
            SSO & SAML integration
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
