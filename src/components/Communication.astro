---
---

<section class="relative bg-white py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <!-- Section header -->
    <div class="mx-auto max-w-2xl text-center reveal">
      <h2 class="text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl lg:text-5xl">
        Communicates Like a <span class="text-gradient">Team Member</span>
      </h2>
      <p class="mt-4 text-lg text-neutral-600">
        Ageneer doesn't just write code in silence. It talks, updates, and collaborates through the same channels your team already uses.
      </p>
    </div>

    <!-- Three cards -->
    <div class="mt-16 grid gap-8 md:grid-cols-3">
      <!-- Messaging card -->
      <div class="reveal reveal-delay-1 group rounded-2xl border border-neutral-200 bg-white p-8 transition-all hover:border-brand-200 hover:shadow-lg">
        <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-600 transition-colors group-hover:bg-brand-100">
          <!-- Chat bubble icon -->
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 0 1-.825-.242m9.345-8.334a2.126 2.126 0 0 0-.476-.095 48.64 48.64 0 0 0-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0 0 11.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-neutral-900">Messaging</h3>
        <p class="mt-3 text-neutral-600">
          Communicates in real-time through your team's messaging platforms. Ask questions, assign tasks, get status updates — all in natural language.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-700">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zm1.271 0a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zm0 1.271a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zm10.124 2.521a2.528 2.528 0 0 1 2.52-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.522 2.521h-2.52V8.834zm-1.271 0a2.528 2.528 0 0 1-2.521 2.521 2.528 2.528 0 0 1-2.521-2.521V2.522A2.528 2.528 0 0 1 15.165 0a2.528 2.528 0 0 1 2.522 2.522v6.312zm-2.522 10.124a2.528 2.528 0 0 1 2.522 2.52A2.528 2.528 0 0 1 15.165 24a2.527 2.527 0 0 1-2.521-2.522v-2.52h2.521zm0-1.271a2.527 2.527 0 0 1-2.521-2.521 2.526 2.526 0 0 1 2.521-2.521h6.313A2.528 2.528 0 0 1 24 15.165a2.528 2.528 0 0 1-2.522 2.522h-6.313z"/></svg>
            Slack
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-700">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M19.821 2.998H4.18A2.18 2.18 0 0 0 2 5.178v13.644A2.18 2.18 0 0 0 4.18 21h11.992l-.56-1.95 1.352 1.256 1.278 1.182L20.4 23.4V5.178a2.18 2.18 0 0 0-2.18-2.18h1.601zM14.19 16.074s-.38-.454-.696-.854c1.382-.39 1.91-1.256 1.91-1.256a6.022 6.022 0 0 1-1.214.622 6.942 6.942 0 0 1-1.53.454 7.104 7.104 0 0 1-2.734-.01 8.522 8.522 0 0 1-1.55-.454 6.166 6.166 0 0 1-.77-.358c-.032-.02-.064-.032-.096-.052a.147.147 0 0 1-.042-.032c-.19-.106-.296-.18-.296-.18s.506.844 1.846 1.246c-.316.4-.706.874-.706.874-2.328-.074-3.214-1.602-3.214-1.602 0-3.392 1.518-6.142 1.518-6.142 1.518-1.138 2.962-1.106 2.962-1.106l.106.126c-1.898.548-2.774 1.382-2.774 1.382s.232-.126.622-.306c1.128-.496 2.028-.632 2.398-.664.064-.01.116-.02.18-.02a9.05 9.05 0 0 1 2.156-.022c1.012.12 2.096.422 3.202 1.034 0 0-.834-.792-2.628-1.34l.148-.17s1.444-.031 2.962 1.107c0 0 1.518 2.75 1.518 6.142 0 0-.896 1.528-3.224 1.602z"/></svg>
            Discord
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-700">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M19.352 3.006H4.648A2.652 2.652 0 0 0 2 5.654v12.692A2.652 2.652 0 0 0 4.648 21h14.704A2.652 2.652 0 0 0 22 18.346V5.654a2.652 2.652 0 0 0-2.648-2.648zM8.26 6.782a1.478 1.478 0 1 1 0 2.956 1.478 1.478 0 0 1 0-2.956zM18 17.57H6V16.2l2.348-2.348 1.174 1.17 4.696-4.696L18 14.022v3.548z"/></svg>
            Teams
          </span>
        </div>
      </div>

      <!-- Video Calls card -->
      <div class="reveal reveal-delay-2 group rounded-2xl border border-neutral-200 bg-white p-8 transition-all hover:border-brand-200 hover:shadow-lg">
        <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-600 transition-colors group-hover:bg-brand-100">
          <!-- Video camera icon -->
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25h-9A2.25 2.25 0 0 0 2.25 7.5v9a2.25 2.25 0 0 0 2.25 2.25Z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-neutral-900">Video Calls</h3>
        <p class="mt-3 text-neutral-600">
          Joins standups, sprint planning, and ad-hoc calls. Ageneer listens, answers questions, takes notes, and follows up with action items.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-700">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M4.585 4.585C2.109 7.061 2.109 11.063 2.109 11.063v1.874c0 4.002 2.476 6.478 2.476 6.478 2.476 2.476 6.478 2.476 6.478 2.476h1.874c4.002 0 6.478-2.476 6.478-2.476 2.476-2.476 2.476-6.478 2.476-6.478v-1.874c0-4.002-2.476-6.478-2.476-6.478C17.939 2.109 13.937 2.109 13.937 2.109h-1.874c-4.002 0-6.478 2.476-6.478 2.476zm3.27 3.346h1.083c.615 0 .937.456.937.937v3.264c0 .481.393.874.874.874h2.502a.75.75 0 0 1 0 1.5h-2.502A2.376 2.376 0 0 1 8.375 12.132V8.868c0-.097-.053-.168-.085-.2a.316.316 0 0 0-.205-.087H7.002a.75.75 0 0 1 0-1.5h.853zm6.073 0h1.083a.75.75 0 0 1 0 1.5h-1.083a.316.316 0 0 0-.205.087c-.032.032-.085.103-.085.2v3.264a2.376 2.376 0 0 1-2.374 2.374h-2.502a.75.75 0 0 1 0-1.5h2.502a.874.874 0 0 0 .874-.874V8.718c0-.481.322-.937.937-.937h.853z"/></svg>
            Zoom
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-700">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C6.28 0 1.636 4.641 1.636 10.364c0 2.004.574 3.87 1.553 5.455L.364 24l8.41-2.774a10.32 10.32 0 0 0 3.226.51C17.72 21.736 22.364 17.09 22.364 11.364 22.364 4.641 17.72 0 12 0zm-1.55 5.867h.674c.228 0 .47.003.658.502.224.594.715 2.09.779 2.242.064.151.107.328.02.527-.587 1.18-1.213 1.14-.894 1.694.956 1.664 1.916 2.262 3.39 2.97.23.11.364.093.498-.057.134-.15.575-.671.728-.9.153-.23.306-.19.515-.115.21.076 1.326.625 1.553.739.228.114.38.17.436.263.058.094.058.548-.128 1.076-.187.528-1.098 1.039-1.51 1.067-.412.027-.798.189-2.648-.551-2.23-.892-3.612-3.165-3.72-3.313-.107-.148-.882-1.17-.882-2.234 0-1.063.556-1.586.753-1.802.197-.216.43-.27.574-.27z"/></svg>
            Google Meet
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-700">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M19.352 3.006H4.648A2.652 2.652 0 0 0 2 5.654v12.692A2.652 2.652 0 0 0 4.648 21h14.704A2.652 2.652 0 0 0 22 18.346V5.654a2.652 2.652 0 0 0-2.648-2.648zM8.26 6.782a1.478 1.478 0 1 1 0 2.956 1.478 1.478 0 0 1 0-2.956zM18 17.57H6V16.2l2.348-2.348 1.174 1.17 4.696-4.696L18 14.022v3.548z"/></svg>
            Teams
          </span>
        </div>
      </div>

      <!-- Async Updates card -->
      <div class="reveal reveal-delay-3 group rounded-2xl border border-neutral-200 bg-white p-8 transition-all hover:border-brand-200 hover:shadow-lg">
        <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-600 transition-colors group-hover:bg-brand-100">
          <!-- Document icon -->
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-neutral-900">Async Updates</h3>
        <p class="mt-3 text-neutral-600">
          Creates pull requests with clear descriptions, writes documentation, comments on issues, and posts progress updates — so your team is always in the loop.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-700">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            Pull Requests
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-700">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" /></svg>
            Docs
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-700">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.076-4.076a1.526 1.526 0 0 1 1.037-.443 48.282 48.282 0 0 0 5.68-.494c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" /></svg>
            Comments
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
