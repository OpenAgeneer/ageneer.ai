---
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2">
      <svg class="h-8 w-8" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="32" height="32" rx="6" fill="#4263eb" />
        <text x="16" y="22" text-anchor="middle" font-family="system-ui,sans-serif" font-weight="700" font-size="18" fill="white">a</text>
      </svg>
      <span class="text-lg font-bold nav-wordmark text-white transition-colors duration-300">ageneer</span>
    </a>

    <!-- Desktop links -->
    <div class="hidden items-center gap-8 md:flex">
      <a href="#how-it-works" class="nav-link text-sm font-medium text-white/70 transition-colors hover:text-white">How It Works</a>
      <a href="#features" class="nav-link text-sm font-medium text-white/70 transition-colors hover:text-white">Features</a>
      <a href="#security" class="nav-link text-sm font-medium text-white/70 transition-colors hover:text-white">Security</a>
      <a
        href="https://github.com/OpenAgeneer/ageneer"
        target="_blank"
        rel="noopener noreferrer"
        class="nav-link text-white/70 transition-colors hover:text-white"
        aria-label="GitHub"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
    </div>

    <!-- CTA + Mobile toggle -->
    <div class="flex items-center gap-4">
      <a
        href="#waitlist"
        class="hidden rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition-all hover:bg-brand-700 sm:inline-block"
      >
        Join Private Beta
      </a>

      <!-- Mobile hamburger -->
      <button
        id="mobile-toggle"
        class="flex h-10 w-10 items-center justify-center rounded-lg text-white/70 transition-colors hover:text-white md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg class="hamburger-icon h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="close-icon hidden h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-white/10 px-6 pb-4 md:hidden">
    <div class="flex flex-col gap-3 pt-3">
      <a href="#how-it-works" class="mobile-link text-sm font-medium text-white/70 transition-colors hover:text-white">How It Works</a>
      <a href="#features" class="mobile-link text-sm font-medium text-white/70 transition-colors hover:text-white">Features</a>
      <a href="#security" class="mobile-link text-sm font-medium text-white/70 transition-colors hover:text-white">Security</a>
      <a href="https://github.com/OpenAgeneer/ageneer" target="_blank" rel="noopener noreferrer" class="mobile-link text-sm font-medium text-white/70 transition-colors hover:text-white">GitHub</a>
      <a href="#waitlist" class="mt-2 inline-block rounded-lg bg-brand-600 px-4 py-2 text-center text-sm font-semibold text-white transition-all hover:bg-brand-700">
        Join Private Beta
      </a>
    </div>
  </div>
</nav>

<script>
  // Scroll-aware navbar background
  const navbar = document.getElementById('navbar');
  const hero = document.querySelector('[data-hero]');

  if (navbar && hero) {
    const obs = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) {
          navbar.classList.add('navbar-scrolled');
        } else {
          navbar.classList.remove('navbar-scrolled');
        }
      },
      { threshold: 0, rootMargin: '-64px 0px 0px 0px' }
    );
    obs.observe(hero);
  }

  // Mobile menu toggle
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  const hamburgerIcon = toggle?.querySelector('.hamburger-icon');
  const closeIcon = toggle?.querySelector('.close-icon');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    hamburgerIcon?.classList.toggle('hidden', isOpen);
    closeIcon?.classList.toggle('hidden', !isOpen);
  });

  // Close mobile menu on link click
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });
</script>

<style>
  :global(.navbar-scrolled) {
    @apply bg-white/90 shadow-sm backdrop-blur-lg;
  }

  :global(.navbar-scrolled) .nav-wordmark {
    @apply text-neutral-900;
  }

  :global(.navbar-scrolled) .nav-link {
    @apply text-neutral-600 hover:text-neutral-900;
  }

  :global(.navbar-scrolled) .mobile-link {
    @apply text-neutral-600 hover:text-neutral-900;
  }

  :global(.navbar-scrolled) #mobile-toggle {
    @apply text-neutral-600 hover:text-neutral-900;
  }

  :global(.navbar-scrolled) #mobile-menu {
    @apply border-neutral-200;
  }
</style>
