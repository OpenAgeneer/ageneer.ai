---
const currentYear = new Date().getFullYear();

const productLinks = [
  { label: 'How It Works', href: '#how-it-works' },
  { label: 'Features', href: '#features' },
  { label: 'Security', href: '#security' },
  { label: 'Join Private Beta', href: '#waitlist' },
];

const resourceLinks = [
  { label: 'Documentation', href: 'https://docs.ageneer.ai', external: true },
  { label: 'Blog', href: '/blog' },
  { label: 'Changelog', href: 'https://github.com/OpenAgeneer/ageneer/releases', external: true },
  { label: 'Roadmap', href: 'https://github.com/OpenAgeneer/ageneer/projects', external: true },
];

const connectLinks = [
  { label: 'GitHub', href: 'https://github.com/OpenAgeneer/ageneer', external: true },
  { label: 'X / Twitter', href: 'https://x.com/ageneer_ai', external: true },
  { label: 'Discord', href: 'https://discord.gg/ageneer', external: true },
  { label: 'Contact', href: 'mailto:hello@ageneer.ai' },
];
---

<footer class="bg-neutral-950 pt-16 pb-8">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid gap-12 md:grid-cols-4">
      <!-- Brand column -->
      <div class="md:col-span-1">
        <a href="/" class="flex items-center gap-2">
          <svg class="h-8 w-8" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="32" height="32" rx="6" fill="#4263eb" />
            <text x="16" y="22" text-anchor="middle" font-family="system-ui,sans-serif" font-weight="700" font-size="18" fill="white">a</text>
          </svg>
          <span class="text-lg font-bold text-white">ageneer</span>
        </a>
        <p class="mt-4 text-sm text-neutral-400">
          Your AI team member. Autonomous, always on, and ready to ship.
        </p>
        <!-- Social links -->
        <div class="mt-6 flex gap-4">
          <a
            href="https://github.com/OpenAgeneer/ageneer"
            target="_blank"
            rel="noopener noreferrer"
            class="text-neutral-500 transition-colors hover:text-white"
            aria-label="GitHub"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          </a>
          <a
            href="https://x.com/ageneer_ai"
            target="_blank"
            rel="noopener noreferrer"
            class="text-neutral-500 transition-colors hover:text-white"
            aria-label="X / Twitter"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
          </a>
        </div>
      </div>

      <!-- Product links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-neutral-400">Product</h3>
        <ul class="mt-4 space-y-3">
          {productLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-neutral-500 transition-colors hover:text-white">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-neutral-400">Resources</h3>
        <ul class="mt-4 space-y-3">
          {resourceLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-neutral-500 transition-colors hover:text-white"
                {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Connect links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-neutral-400">Connect</h3>
        <ul class="mt-4 space-y-3">
          {connectLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-neutral-500 transition-colors hover:text-white"
                {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Divider -->
    <div class="mt-12 border-t border-white/10 pt-8">
      <p class="text-center text-sm text-neutral-500">
        &copy; {currentYear} Ageneer. Built by Ortwin Kartmann, Paul Koeck &amp; Simon Koeck.
      </p>
    </div>
  </div>
</footer>
